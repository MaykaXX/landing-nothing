//- Інлайн-SVG іконка за назвою (24x24, stroke). Декоративна: aria-hidden.
mixin icon(name, cls = '')
  - const filled = name === 'quote';
  svg(
    class=cls || null,
    viewBox='0 0 24 24',
    width='24',
    height='24',
    aria-hidden='true',
    fill=filled ? 'currentColor' : 'none',
    stroke=filled ? 'none' : 'currentColor',
    stroke-width='2',
    stroke-linecap='round',
    stroke-linejoin='round'
  )
    case name
      when 'heart'
        path(
          d='M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21.2l7.8-7.7 1-1.1a5.5 5.5 0 0 0 0-7.8z'
        )
      when 'mail'
        path(d='M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z')
        path(d='m22 6-10 7L2 6')
      when 'burger'
        path(d='M3 6h18M3 12h18M3 18h18')
      when 'close'
        path(d='M18 6 6 18M6 6l12 12')
      when 'arrow-up'
        path(d='M12 19V5M5 12l7-7 7 7')
      when 'plus'
        path(d='M12 5v14M5 12h14')
      when 'quote'
        path(d='M6 17h3l2-4V7H5v6h3l-2 4zm8 0h3l2-4V7h-6v6h3l-2 4z')
      when 'pen'
        path(d='M12 19l7-7 3 3-7 7-3-3z')
        path(d='M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z')
        path(d='M2 2l7.6 7.6')
        circle(cx='11', cy='11', r='2')
      when 'monitor'
        rect(x='2', y='3', width='20', height='14', rx='2')
        path(d='M8 21h8M12 17v4')
      when 'layers'
        path(d='M12 2 2 7l10 5 10-5-10-5z')
        path(d='m2 17 10 5 10-5M2 12l10 5 10-5')
      when 'play'
        circle(cx='12', cy='12', r='10')
        path(d='m10 8 6 4-6 4V8z')
      when 'facebook'
        path(d='M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z')
      when 'twitter'
        path(
          d='M23 3a10.9 10.9 0 0 1-3.1 1.5 4.5 4.5 0 0 0-7.9 3v1A10.7 10.7 0 0 1 3 4s-4 9 5 13a11.6 11.6 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.1-.8A7.7 7.7 0 0 0 23 3z'
        )
      when 'instagram'
        rect(x='2', y='2', width='20', height='20', rx='5')
        path(d='M16 11.4A4 4 0 1 1 12.6 8 4 4 0 0 1 16 11.4zM17.5 6.5h.01')
      when 'dribbble'
        circle(cx='12', cy='12', r='10')
        path(
          d='M8.6 2.8c4.4 6 6 9.4 8 17.7m2.5-15.4c-3.7 4.3-8.9 5.7-16.9 5.8m19.5 1.9c-3.5-.9-6.6-.8-8.9 0-2.6.9-5 2.9-7.4 6.3'
        )
