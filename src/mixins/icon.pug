//- Інлайн-SVG з src/assets/icons/*.svg; колір керується через currentColor.
mixin icon(name)
  case name
    when 'phone'
      include ../assets/icons/phone.svg
    when 'burger'
      include ../assets/icons/burger.svg
    when 'burger-hover'
      include ../assets/icons/burger-hover.svg
    when 'close'
      include ../assets/icons/close.svg
    when 'logo'
      include ../assets/icons/logo.svg
