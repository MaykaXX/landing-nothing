//- <picture>: AVIF -> WebP -> JPEG, srcset/sizes, width/height, lazy / fetchpriority.
//- Файли створює `npm run images`: src/assets/images/<name>-<width>.(avif|webp|jpg).
mixin picture(image, alt, opts = {})
  - const { sizes = '100vw', lazy = true, cls = '' } = opts;
  - const dir = '/src/assets/images';
  - const srcset = (ext) => image.widths.map((w) => `${dir}/${image.name}-${w}.${ext} ${w}w`).join(', ');
  picture
    source(type='image/avif', srcset=srcset('avif'), sizes=sizes)
    source(type='image/webp', srcset=srcset('webp'), sizes=sizes)
    img(
      class=cls || null,
      src=`${dir}/${image.name}-${image.widths[image.widths.length - 1]}.jpg`,
      srcset=srcset('jpg'),
      sizes=sizes,
      alt=alt,
      width=image.width,
      height=image.height,
      loading=lazy ? 'lazy' : null,
      fetchpriority=lazy ? null : 'high',
      decoding='async'
    )
