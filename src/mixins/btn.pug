//- Кнопка або посилання-кнопка. Без href рендериться <button>.
//- Вкладений вміст (block) - іконка перед підписом; довільні атрибути - через &attributes.
mixin btn(label, href, variant = 'primary')
  - let modifier = 'btn--primary';
  case variant
    when 'secondary'
      - modifier = 'btn--secondary';
    default
      - modifier = 'btn--primary';
  - const tag = href ? 'a' : 'button';
  #{tag}.btn(class=modifier, href=href, type=href ? null : 'button')&attributes(attributes)
    if block
      block
    span.btn__label= label
