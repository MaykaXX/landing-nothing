mixin logo
  a.logo(href='#top', aria-label='Keepsake, back to top')
    svg.logo__mark(viewBox='0 0 40 40', width='40', height='40', aria-hidden='true')
      circle.logo__circle(cx='20', cy='20', r='20')
      text.logo__letter(x='20', y='28', text-anchor='middle', font-size='26', font-weight='700') K
    span.logo__text Keepsake
