header.c-header
  .c-header__inner.o-container
    +logo
    .c-header__controls
      a.c-icon-button(
        href=`tel:${contacts.phoneHref}`,
        aria-label=`Call us: ${contacts.phoneHeader}`
      )
        span.c-icon-button__number= contacts.phoneHeader
        span.c-icon-button__icon
          +icon('phone')
      a.c-icon-button.c-icon-button--swap(href='#menu', aria-label='Open menu')
        span.c-icon-button__icon.c-icon-button__icon--default
          +icon('burger')
        span.c-icon-button__icon.c-icon-button__icon--hover
          +icon('burger-hover')
