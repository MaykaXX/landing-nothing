section.c-hero(aria-labelledby='hero-title')
  .c-hero__media
    +picture(images.hero, '', {
      lazy: false,
      cls: 'c-hero__image',
      sizes:
        '(min-width: 1260px) 100vw, (min-width: 744px) max(100vw, 1244px), max(100vw, 712px)',
    })
  .c-hero__inner.o-container.o-grid
    h1#hero-title.c-hero__title Bring joy back to the everyday
