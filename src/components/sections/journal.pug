section#journal.section.journal(aria-labelledby='journal-title')
  .container
    +section-title('From the journal')#journal-title
    ul.journal__list
      each post in posts
        li.journal__item
          article.post
            +picture(post.image, post.alt, {
              widths: [150, 300],
              width: 300,
              height: 300,
              sizes: '(min-width: 768px) 150px, 96px',
              cls: 'post__img',
            })
            .post__body
              p.post__meta
                time(datetime=post.date)= post.dateLabel
                span.post__category= post.category
              h3.post__title= post.title
              p.post__text= post.excerpt
              a.post__link(href='#')
                | Read more
                span.visually-hidden= ` about ${post.title}`
