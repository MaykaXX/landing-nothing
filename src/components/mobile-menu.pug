//- Меню відкривається нативним Popover API (popovertarget), без JavaScript.
#mobile-menu.mobile-menu(popover='')
  nav(aria-label='Mobile')
    ul.mobile-menu__list
      each item in nav
        li.mobile-menu__item
          a.mobile-menu__link(
            href=item.href,
            class={ 'mobile-menu__link--active': item.active },
            aria-current=item.active ? 'page' : null
          )= item.label
  .mobile-menu__actions
    +btn('Contact us', '#contact')
      +icon('mail', 'btn__icon')
    +btn('Favourites', '#', 'secondary')(aria-label='Favourites')
      +icon('heart', 'btn__icon')
  address.mobile-menu__contacts
    a.mobile-menu__contact(href=`mailto:${contacts.email}`)= contacts.email
    a.mobile-menu__contact(href=`tel:${contacts.phoneHref}`)= contacts.phone
  +socials(socials)
