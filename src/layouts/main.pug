doctype html
html(lang='en')
  head
    include ../includes/meta-base.pug
    block meta
      meta(name='theme-color', content='#f95858')
      link(
        rel='icon',
        href='data:image/svg+xml,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 40 40\'><circle cx=\'20\' cy=\'20\' r=\'20\' fill=\'%233a3a3c\'/><text x=\'20\' y=\'28\' text-anchor=\'middle\' font-size=\'26\' font-weight=\'700\' fill=\'white\' font-family=\'serif\'>K</text></svg>'
      )
    title
      block title
        | Keepsake
    block styles
      link(rel='stylesheet', href='/src/styles/main.scss')
  body#top
    include ../components/header.pug
    main
      block content
    include ../components/footer.pug
    a.icon-btn.icon-btn--lg.to-top(href='#top', aria-label='Back to top')
      +icon('arrow-up', 'icon-btn__icon')
    block scripts
